{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "observed_outcome", "decisions", "questions", "proposal", "artifacts", "scripted_responses_used", "terminal_condition", "vault_boundary"],
        "properties": {
          "id": { "type": "string" },
          "observed_outcome": { "type": "string" },
          "decisions": { "type": "array", "items": { "type": "string" } },
          "questions": { "type": "array", "items": { "type": "string" } },
          "proposal": { "type": "array", "items": { "type": "string" } },
          "artifacts": { "type": "array", "items": { "type": "string" } },
          "scripted_responses_used": { "type": "integer", "minimum": 0 },
          "terminal_condition": { "type": "string" },
          "vault_boundary": { "type": "string", "enum": ["active-vault", "would-leave-vault", "unknown"] }
        }
      }
    }
  }
}
